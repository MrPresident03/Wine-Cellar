insertValue:
INSERT INTO market_value(id, household_id, vintage_id, format_ml, amount_minor, currency, source, source_ref, as_of, note, created_at, updated_at, updated_by)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

softDeleteValue:
UPDATE market_value SET deleted_at = :now, updated_at = :now, updated_by = :by WHERE id = :id;

valuesFor:
SELECT * FROM market_value WHERE vintage_id = ? AND deleted_at IS NULL ORDER BY as_of DESC, created_at DESC;

reassignValues:
UPDATE market_value SET vintage_id = :vintageId, updated_at = :now, updated_by = :by WHERE vintage_id = :oldVintageId AND deleted_at IS NULL;

latestValues:
SELECT mv.* FROM market_value mv
WHERE mv.household_id = ? AND mv.deleted_at IS NULL
  AND NOT EXISTS (
    SELECT 1 FROM market_value newer
    WHERE newer.vintage_id = mv.vintage_id AND newer.format_ml = mv.format_ml AND newer.deleted_at IS NULL
      AND (newer.as_of > mv.as_of OR (newer.as_of = mv.as_of AND newer.created_at > mv.created_at))
  );

insertRate:
INSERT INTO fx_rate(id, household_id, from_currency, to_currency, rate, as_of, source, created_at, updated_at, updated_by)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

softDeleteRate:
UPDATE fx_rate SET deleted_at = :now, updated_at = :now, updated_by = :by WHERE id = :id;

rates:
SELECT * FROM fx_rate WHERE household_id = ? AND deleted_at IS NULL ORDER BY as_of DESC;

valueIdsForVintage:
SELECT id FROM market_value WHERE vintage_id = ?;
